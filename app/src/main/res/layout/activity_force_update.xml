<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/abbadi_bg" android:gravity="center"
    android:orientation="vertical" android:padding="28dp">

    <com.github.libretube.ui.abbadi.AbbadiLogoView
        android:layout_width="wrap_content" android:layout_height="56dp" />

    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="32dp" android:background="@drawable/abbadi_force_card"
        android:orientation="vertical" android:padding="24dp">

        <TextView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/abbadi_force_title" android:textColor="#FFFFFFFF"
            android:textSize="22sp" android:textStyle="bold" />

        <TextView
            android:id="@+id/message"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:text="@string/abbadi_force_default"
            android:textColor="#B3FFFFFF" android:textSize="15sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/update"
            android:layout_width="match_parent" android:layout_height="56dp"
            android:layout_marginTop="24dp" android:text="@string/abbadi_update_now" />
    </LinearLayout>

    <TextView
        android:id="@+id/developer"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="28dp" android:padding="8dp"
        android:text="@string/abbadi_developer" android:textColor="#99FFFFFF" android:textSize="12sp" />
</LinearLayout>
