<?xml version="1.0" encoding="utf-8"?>
<!-- Floating detached glass pill nav bar with a top-edge highlight -->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:insetLeft="16dp" android:insetRight="16dp" android:insetBottom="12dp" android:insetTop="4dp">
    <layer-list>
        <item>
            <shape android:shape="rectangle">
                <gradient android:angle="90" android:startColor="#E00C0C0E" android:endColor="#C0161618" />
                <stroke android:width="1dp" android:color="#40FFFFFF" />
                <corners android:radius="40dp" />
            </shape>
        </item>
        <item android:height="1dp" android:gravity="top" android:left="28dp" android:right="28dp" android:top="1dp">
            <shape android:shape="rectangle"><solid android:color="#59FFFFFF" /></shape>
        </item>
    </layer-list>
</inset>
