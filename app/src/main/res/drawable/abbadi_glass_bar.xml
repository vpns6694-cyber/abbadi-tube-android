<?xml version="1.0" encoding="utf-8"?>
<!-- Floating frosted glass nav container (translucent, edge highlight) -->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:insetLeft="16dp" android:insetRight="16dp" android:insetBottom="10dp" android:insetTop="6dp">
    <layer-list>
        <item>
            <shape android:shape="rectangle">
                <gradient android:angle="90" android:startColor="#99101012" android:endColor="#73202024" />
                <stroke android:width="1dp" android:color="#2EFFFFFF" />
                <corners android:radius="36dp" />
            </shape>
        </item>
        <item android:height="24dp" android:gravity="top" android:left="1dp" android:right="1dp" android:top="1dp">
            <shape android:shape="rectangle">
                <gradient android:angle="270" android:startColor="#1AFFFFFF" android:endColor="#00FFFFFF" />
                <corners android:topLeftRadius="35dp" android:topRightRadius="35dp" />
            </shape>
        </item>
    </layer-list>
</inset>
